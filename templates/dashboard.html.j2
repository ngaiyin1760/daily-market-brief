<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Market Brief — {{ page_date|e }}</title>
<meta name="theme-color" content="#4338ca">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Market Brief">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="manifest" href="{{ base }}/site.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="{{ base }}/icons/favicon-32.png">
<link rel="apple-touch-icon" href="{{ base }}/icons/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  :root {
    --sidebar-w: 230px;
    --paper: #f7f2e9;
    --card: #fffdf8;
    --ink: #221f1a;
    --ink-soft: #514c42;
    --muted: #8d8574;
    --rule: #e0d8c6;
    --rule-dark: #b6ab92;
    --accent: #4338ca;          /* deep indigo */
    --accent-2: #0f766e;        /* teal */
    --gold: #c9a227;
    --green: #0d9d6c;
    --red: #d13438;
    --serif: 'Playfair Display', Garamond, Cambria, Georgia, serif;
    --sans: 'Source Sans 3', 'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    font-size: 16px;
  }

  /* ---------- Sidebar ---------- */
  .sidebar {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--sidebar-w);
    background: linear-gradient(180deg, #171233 0%, #241a4d 60%, #1c1440 100%);
    color: #cfc9bb;
    padding: 28px 0;
    overflow-y: auto;
    border-right: 1px solid #0d0a1f;
  }
  .sidebar .site-title {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 700;
    color: #f6f1e4;
    padding: 0 22px 16px;
    border-bottom: 1px solid rgba(201, 162, 39, .35);
    margin-bottom: 6px;
    letter-spacing: .01em;
  }
  .sidebar .site-sub {
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 0 22px 16px;
  }
  .sidebar nav { padding-top: 8px; }
  .sidebar nav a {
    display: block;
    padding: 7px 22px;
    color: #b0a898;
    text-decoration: none;
    font-size: 14.5px;
    border-left: 3px solid transparent;
    transition: background .12s, color .12s, border-color .12s;
  }
  .sidebar nav a:hover { background: rgba(255, 255, 255, .06); color: #f4eedd; }
  .sidebar nav a.active {
    background: rgba(201, 162, 39, .14);
    color: #f8f3e6;
    border-left-color: var(--gold);
    font-weight: 600;
  }

  /* ---------- Content ---------- */
  .content {
    margin-left: var(--sidebar-w);
    padding: 34px 44px 80px;
    max-width: 1240px;
  }

  /* Masthead band */
  header.masthead {
    background: linear-gradient(120deg, #241a4d 0%, #4338ca 55%, #0f766e 130%);
    border-radius: 8px;
    color: #f6f1e4;
    padding: 30px 34px 26px;
    margin-bottom: 0;
    box-shadow: 0 3px 14px rgba(36, 26, 77, .25);
  }
  header.masthead .kicker {
    font-size: 12px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 8px;
  }
  header.masthead h1 {
    font-family: var(--serif);
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
  }
  header.masthead .generated {
    color: rgba(246, 241, 228, .72);
    font-size: 14px;
    font-style: italic;
    margin-top: 8px;
  }

  /* Snapshot ticker strip */
  .ticker {
    border-bottom: 1px solid var(--rule-dark);
    padding: 10px 4px;
    margin-bottom: 30px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .06em;
    color: var(--ink-soft);
    font-variant: small-caps;
    white-space: nowrap;
    overflow-x: auto;
  }

  /* ---------- Key Takeaways ---------- */
  .takeaways {
    background: linear-gradient(135deg, #f1ecfd 0%, #e9f6f2 100%);
    border: 1px solid #d4c8f2;
    border-left: 5px solid var(--accent);
    border-radius: 6px;
    padding: 20px 26px 16px;
    margin-bottom: 40px;
    box-shadow: 0 2px 8px rgba(67, 56, 202, .10);
  }
  .takeaways .tw-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .takeaways ul { margin: 0; padding-left: 20px; }
  .takeaways li {
    margin-bottom: 8px;
    font-size: 16.5px;
    line-height: 1.45;
  }
  .takeaways li::marker { color: var(--gold); }

  /* ---------- Sections ---------- */
  section.desk { margin-bottom: 44px; }
  section.desk > h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--cat, var(--accent));
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-dark);
  }
  section.desk > h2::before {
    content: "";
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 2px;
    background: var(--cat, var(--accent));
    margin-right: 9px;
  }
  section.desk > h2::after {
    content: "";
    display: block;
    width: 56px;
    border-bottom: 3px solid var(--cat, var(--accent));
    margin-top: 6px;
    margin-bottom: -9px;
  }

  /* News table */
  table.news { width: 100%; border-collapse: collapse; }
  table.news th, table.news td {
    text-align: left;
    padding: 14px 14px 14px 8px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  table.news th {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    padding-top: 10px;
    padding-bottom: 6px;
  }
  table.news tbody tr { transition: background .12s; }
  table.news tbody tr:nth-child(even) { background: rgba(67, 56, 202, .025); }
  table.news tbody tr:hover { background: rgba(201, 162, 39, .09); }
  table.news tr:last-child td { border-bottom: none; }
  td.headline { width: 30%; }
  td.headline a {
    font-family: var(--serif);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 17.5px;
    line-height: 1.3;
  }
  td.headline a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; }
  td.headline .pub { font-size: 12.5px; color: var(--muted); font-style: italic; margin-top: 5px; }
  td.summary ul { margin: 0; padding-left: 18px; }
  td.summary li { margin-bottom: 5px; font-size: 15px; color: var(--ink-soft); }
  td.source { white-space: nowrap; }
  td.source .chip {
    display: inline-block;
    background: #efe9f9;
    color: #4c3d8f;
    border: 1px solid #ddd2f2;
    border-radius: 999px;
    padding: 2px 11px;
    font-size: 12.5px;
    font-style: normal;
  }
  td.rating {
    white-space: nowrap;
    color: var(--gold);
    font-size: 16px;
    letter-spacing: .08em;
    text-shadow: 0 1px 0 rgba(120, 90, 10, .18);
  }
  td.rating .reason {
    display: block;
    color: var(--muted);
    font-size: 12.5px;
    font-style: italic;
    letter-spacing: 0;
    max-width: 130px;
    white-space: normal;
    text-shadow: none;
  }
  .empty-note { color: var(--muted); font-style: italic; padding: 12px 0; }

  /* ---------- Indicators ---------- */
  .indicator-group { margin-top: 30px; }
  .indicator-group h3 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 14px;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }
  .chart-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--rule-dark);
    border-radius: 5px;
    box-shadow: 0 1px 4px rgba(34, 31, 26, .08);
    padding: 14px 16px 10px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .chart-card.up { border-top-color: var(--green); }
  .chart-card.down { border-top-color: var(--red); }
  .chart-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(34, 31, 26, .14);
  }
  .chart-card .cc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .chart-card .cc-name { font-family: var(--serif); font-weight: 600; font-size: 16px; }
  .chart-card .cc-last {
    font-size: 16px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .chart-card .cc-change {
    font-size: 13.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-top: 1px;
  }
  .chart-card .cc-change.pos { color: var(--green); }
  .chart-card .cc-change.neg { color: var(--red); }
  .chart-card .cc-change.na, .chart-card .cc-na { color: var(--muted); }
  .chart-card .cc-body { height: 150px; margin-top: 8px; position: relative; }
  .chart-card .cc-na {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    font-size: 14px;
    border-top: 1px dashed var(--rule);
    margin-top: 8px;
  }

  /* Compact numbers table */
  table.figures { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  table.figures th, table.figures td {
    text-align: left;
    padding: 6px 12px 6px 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }
  table.figures th {
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  table.figures tr:last-child td { border-bottom: none; }
  table.figures td.num, table.figures th.num { text-align: right; padding-right: 0; }
  .pos { color: var(--green); }
  .neg { color: var(--red); }
  .na { color: var(--muted); }

  footer.colophon {
    margin-top: 40px;
    padding-top: 14px;
    border-top: 1px solid var(--rule-dark);
    color: var(--muted);
    font-size: 13px;
    font-style: italic;
  }

  @media (max-width: 820px) {
    body { font-size: 16px; line-height: 1.55; }

    /* Sidebar becomes a compact, horizontally scrollable date strip */
    .sidebar {
      position: static;
      width: 100%;
      padding: 12px 0 10px;
      border-right: none;
      border-bottom: 1px solid #0d0a1f;
    }
    .sidebar .site-title {
      padding: 0 16px 6px;
      font-size: 18px;
      border-bottom: none;
      margin-bottom: 0;
    }
    .sidebar .site-sub { display: none; }
    .sidebar nav {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: 8px;
      padding: 6px 14px 4px;
      scrollbar-width: none;
    }
    .sidebar nav::-webkit-scrollbar { display: none; }
    .sidebar nav a {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 8px 16px;
      border: 1px solid rgba(201, 162, 39, .45);
      border-left: 1px solid rgba(201, 162, 39, .45);
      border-radius: 999px;
      font-size: 14px;
      white-space: nowrap;
    }
    .sidebar nav a:hover { background: rgba(255, 255, 255, .08); }
    .sidebar nav a.active {
      background: var(--gold);
      color: #1c1440;
      border-color: var(--gold);
      border-bottom: 1px solid var(--gold);
      font-weight: 700;
    }

    .content { margin-left: 0; padding: 16px 14px 60px; }
    header.masthead { padding: 20px 18px 18px; border-radius: 6px; }
    header.masthead h1 { font-size: 27px; }

    /* Ticker wraps instead of forcing horizontal scroll */
    .ticker { white-space: normal; line-height: 1.7; margin-bottom: 24px; }

    .takeaways { padding: 16px 16px 12px; margin-bottom: 32px; }
    .takeaways li { font-size: 15.5px; }

    /* News rows reflow into stacked cards — no horizontal scrolling */
    table.news thead { display: none; }
    table.news, table.news tbody, table.news tr, table.news td {
      display: block;
      width: 100%;
    }
    table.news tbody tr {
      border-bottom: 1px solid var(--rule-dark);
      padding: 12px 0;
    }
    table.news tbody tr:nth-child(even) { background: none; }
    table.news td { border-bottom: none; padding: 4px 4px; }
    td.headline { width: 100%; }
    td.headline a { font-size: 17px; display: block; padding: 6px 0; }
    td.summary li { font-size: 15px; }
    td.source { padding-top: 6px; }
    td.rating { padding-top: 4px; }
    td.rating .reason { max-width: none; }

    /* Figures tables stay 3 columns but get breathing room */
    table.figures { font-size: 14px; }

    .chart-grid { grid-template-columns: 1fr; gap: 14px; }
    .chart-card .cc-body { height: 180px; }
    .chart-card .cc-na { height: 120px; }

    section.desk { margin-bottom: 36px; }
  }
</style>
</head>
<body>
{% set cat_colors = {
  "global-macro": "#4338ca",
  "equity": "#047857",
  "fixed-income": "#92400e",
  "china": "#be123c",
  "hk": "#1d4ed8",
  "tech": "#7c3aed",
  "ai": "#c026d3",
  "semis": "#0e7490",
  "ev": "#65a30d",
  "data-center": "#b45309",
  "space": "#581c87"
} %}
<aside class="sidebar">
  <div class="site-title">Daily Market Brief</div>
  <div class="site-sub">Market Intelligence</div>
  <nav id="date-nav"><a href="#" class="na">Loading…</a></nav>
</aside>

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>{{ page_date|e }}</h1>
    <div class="generated">Generated {{ generated_at|e }}</div>
  </header>
  {% if snapshot %}<div class="ticker">{{ snapshot|e }}</div>{% endif %}

  {% if takeaways %}
  <section class="takeaways" id="takeaways">
    <div class="tw-label">Today's Key Takeaways</div>
    <ul>
      {% for t in takeaways %}<li>{{ t|e }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {# ---- News sections first ---- #}
  {% for cat in categories %}
  <section class="desk" id="{{ cat.id|e }}"
           style="--cat: {{ cat_colors.get(cat.id, '#4338ca') }}">
    <h2>{{ cat.label|e }}</h2>
    {% if cat["items"] %}
    <table class="news">
      <thead>
        <tr><th>Headline</th><th>Summary</th><th>Source</th><th>Rating</th></tr>
      </thead>
      <tbody>
        {% for item in cat["items"] %}
        <tr>
          <td class="headline">
            <a href="{{ item.url|e }}" target="_blank" rel="noopener">{{ item.title|e }}</a>
            {% if item.published %}<div class="pub">{{ item.published|e }}</div>{% endif %}
          </td>
          <td class="summary">
            <ul>
              {% for b in item.bullets %}<li>{{ b|e }}</li>{% endfor %}
            </ul>
          </td>
          <td class="source"><span class="chip">{{ item.source|e }}</span></td>
          <td class="rating">
            {{- "★" * item.rating }}{{ "☆" * (5 - item.rating) -}}
            {% if item.reason %}<span class="reason">{{ item.reason|e }}</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty-note">No news available for this category today.</p>
    {% endif %}
  </section>
  {% endfor %}

  {# ---- Key Indicators at the bottom ---- #}
  <section class="desk" id="indicators">
    <h2>Key Indicators</h2>
    {% for group in indicator_groups %}
    <div class="indicator-group">
      <h3>{{ group.name|e }}</h3>
      <div class="chart-grid">
        {% for item in group["items"] %}
        <div class="chart-card{% if item.closes and item.closes|length > 1 %} {{ 'up' if item.closes[-1] >= item.closes[0] else 'down' }}{% endif %}">
          <div class="cc-head">
            <span class="cc-name">{{ item.label|e }}</span>
            <span class="cc-last">
              {%- if item.last is not none -%}
                {{ "%.2f"|format(item.last) }}{% if item.kind == "yield" %}%{% endif %}
              {%- else -%}<span class="na">n/a</span>{%- endif -%}
            </span>
          </div>
          <div class="cc-change
            {%- if item.kind == 'yield' and item.change_bp is not none %} {{ 'pos' if item.change_bp >= 0 else 'neg' }}
            {%- elif item.change is not none %} {{ 'pos' if item.change >= 0 else 'neg' }}
            {%- else %} na{%- endif -%}">
            {%- if item.kind == "yield" -%}
              {%- if item.change_bp is not none -%}{{ "%+.1f"|format(item.change_bp) }} bp{%- else -%}—{%- endif -%}
            {%- else -%}
              {%- if item.change is not none -%}{{ "%+.2f"|format(item.change) }}%{%- else -%}—{%- endif -%}
            {%- endif -%}
          </div>
          {% if item.closes and item.closes|length > 1 %}
          <div class="cc-body">
            <canvas class="trend" data-closes='{{ item.closes|tojson }}'
                    data-labels='{{ item.labels|tojson }}'
                    data-kind="{{ item.kind|e }}"></canvas>
          </div>
          {% else %}
          <div class="cc-na">No data available</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <table class="figures">
        <thead>
          <tr><th>Instrument</th><th class="num">Last</th><th class="num">Daily Change</th></tr>
        </thead>
        <tbody>
          {% for item in group["items"] %}
          <tr>
            <td>{{ item.label|e }}</td>
            <td class="num">
              {%- if item.last is not none -%}
                {{ "%.2f"|format(item.last) }}{% if item.kind == "yield" %}%{% endif %}
              {%- else -%}<span class="na">n/a</span>{%- endif -%}
            </td>
            <td class="num">
              {%- if item.kind == "yield" -%}
                {%- if item.change_bp is not none -%}
                  <span class="{{ 'pos' if item.change_bp >= 0 else 'neg' }}">{{ "%+.1f"|format(item.change_bp) }} bp</span>
                {%- else -%}<span class="na">n/a</span>{%- endif -%}
              {%- else -%}
                {%- if item.change is not none -%}
                  <span class="{{ 'pos' if item.change >= 0 else 'neg' }}">{{ "%+.2f"|format(item.change) }}%</span>
                {%- else -%}<span class="na">n/a</span>{%- endif -%}
              {%- endif -%}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  </section>

  <footer class="colophon">
    Daily Market Brief — generated automatically from public news feeds and market data. For information only; not investment advice.
  </footer>
</div>

<script>
(function () {
  var base = {{ base|tojson }};
  var currentDate = {{ page_date|tojson }};

  // Build the sidebar date list from manifest.json so that every page —
  // including older day pages — automatically shows newly added days.
  fetch(base + "/manifest.json")
    .then(function (r) { return r.json(); })
    .then(function (m) {
      var nav = document.getElementById("date-nav");
      nav.innerHTML = "";
      (m.dates || []).forEach(function (d, idx) {
        var a = document.createElement("a");
        a.textContent = d;
        a.href = idx === 0 ? base + "/index.html" : base + "/days/" + d + ".html";
        if (d === currentDate) a.className = "active";
        nav.appendChild(a);
      });
    })
    .catch(function () {
      document.getElementById("date-nav").innerHTML =
        '<a href="' + base + '/index.html">Latest</a>';
    });

  // Trend charts — one proper line chart per instrument.
  var UP = "#0d9d6c", DOWN = "#d13438";
  var CHART_FONT = "'Source Sans 3', 'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif";

  function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16),
        g = parseInt(hex.slice(3, 5), 16),
        b = parseInt(hex.slice(5, 7), 16);
    return "rgba(" + r + "," + g + "," + b + "," + alpha + ")";
  }

  document.querySelectorAll("canvas.trend").forEach(function (cv) {
    var closes = JSON.parse(cv.getAttribute("data-closes"));
    if (!closes || closes.length < 2) return;
    var dateLabels = JSON.parse(cv.getAttribute("data-labels") || "[]");
    if (dateLabels.length !== closes.length) {
      dateLabels = closes.map(function (_, i) { return i; });
    }
    var up = closes[closes.length - 1] >= closes[0];
    var color = up ? UP : DOWN;
    new Chart(cv.getContext("2d"), {
      type: "line",
      data: {
        labels: dateLabels,
        datasets: [{
          data: closes,
          borderColor: color,
          borderWidth: 2.2,
          pointRadius: 0,
          pointHitRadius: 10,
          pointHoverRadius: 4,
          pointHoverBackgroundColor: color,
          tension: 0.35,
          fill: true,
          backgroundColor: function (ctx) {
            var area = ctx.chart.chartArea;
            if (!area) return hexToRgba(color, 0.15);
            var grad = ctx.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            grad.addColorStop(0, hexToRgba(color, 0.28));
            grad.addColorStop(1, hexToRgba(color, 0.02));
            return grad;
          }
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            displayColors: false,
            backgroundColor: "rgba(34, 31, 26, .92)",
            titleColor: "#c9a227",
            bodyColor: "#f6f1e4",
            padding: 10,
            cornerRadius: 6,
            titleFont: { family: CHART_FONT, size: 12 },
            bodyFont: { family: CHART_FONT, size: 14, weight: "600" },
            callbacks: {
              title: function (items) {
                return items.length ? String(items[0].label) : "";
              },
              label: function (ctx) {
                var v = ctx.parsed.y;
                return v.toLocaleString(undefined, { maximumFractionDigits: 2 });
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            border: { display: false },
            ticks: {
              autoSkip: true,
              maxTicksLimit: 5,
              maxRotation: 0,
              font: { family: CHART_FONT, size: 10.5 },
              color: "#8d8574",
              padding: 4
            }
          },
          y: {
            position: "right",
            grid: { color: "#ece5d4", drawTicks: false },
            border: { display: false },
            ticks: {
              maxTicksLimit: 4,
              font: { family: CHART_FONT, size: 10.5 },
              color: "#8d8574",
              padding: 4,
              callback: function (v) {
                return v.toLocaleString(undefined, { maximumFractionDigits: 1 });
              }
            }
          }
        }
      }
    });
  });
})();
</script>
</body>
</html>
