<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Market Brief — {{ page_date|e }}</title>
{% include "partials/head.j2" %}
</head>
<body>
{% set cat_colors = {
  "global-macro": "#4338ca",
  "equity": "#047857",
  "fixed-income": "#92400e",
  "china": "#be123c",
  "hk": "#1d4ed8",
  "tech": "#7c3aed",
  "ai": "#c026d3",
  "semis": "#0e7490",
  "ev": "#65a30d",
  "data-center": "#b45309",
  "space": "#581c87"
} %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>{{ page_date|e }}</h1>
    <div class="generated">Generated {{ generated_at|e }}</div>
  </header>
  {% if snapshot %}<div class="ticker">{{ snapshot|e }}</div>{% endif %}

  {% if takeaways %}
  <section class="takeaways" id="takeaways">
    <div class="tw-label">Today's Key Takeaways</div>
    <ul>
      {% for t in takeaways %}<li>{{ t|e }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {# ---- News sections first ---- #}
  {% for cat in categories %}
  <section class="desk" id="{{ cat.id|e }}"
           style="--cat: {{ cat_colors.get(cat.id, '#4338ca') }}">
    <h2>{{ cat.label|e }}</h2>
    {% if cat["items"] %}
    <table class="news">
      <thead>
        <tr><th>Headline</th><th>Summary</th><th>Source</th><th>Rating</th><th class="save-col"><span class="visually-hidden">Save</span></th></tr>
      </thead>
      <tbody>
        {% for item in cat["items"] %}
        <tr class="news-item"
            data-url="{{ item.url|e }}"
            data-title="{{ item.title|e }}"
            data-source="{{ item.source|e }}"
            data-category="{{ cat.label|e }}"
            data-rating="{{ item.rating }}"
            data-date="{{ page_date|e }}">
          <td class="headline">
            <a href="{{ item.url|e }}" target="_blank" rel="noopener">{{ item.title|e }}</a>
            {% if item.published %}<div class="pub">{{ item.published|e }}</div>{% endif %}
          </td>
          <td class="summary">
            <ul>
              {% for b in item.bullets %}<li>{{ b|e }}</li>{% endfor %}
            </ul>
          </td>
          <td class="source"><span class="chip">{{ item.source|e }}</span></td>
          <td class="rating">
            {{- "★" * item.rating }}{{ "☆" * (5 - item.rating) -}}
            {% if item.reason %}<span class="reason">{{ item.reason|e }}</span>{% endif %}
          </td>
          <td class="save-cell">
            <button type="button" class="save-btn" aria-label="Save this story" title="Save this story">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                <path d="M6.5 2.5h11a1 1 0 0 1 1 1v18l-6.5-4.2-6.5 4.2v-18a1 1 0 0 1 1-1z"
                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty-note">No news available for this category today.</p>
    {% endif %}
  </section>
  {% endfor %}

  {# ---- Key Indicators at the bottom ---- #}
  <section class="desk" id="indicators">
    <h2>Key Indicators</h2>
    {% for group in indicator_groups %}
    <div class="indicator-group">
      <h3>{{ group.name|e }}</h3>
      <div class="chart-grid">
        {% for item in group["items"] %}
        <div class="chart-card{% if item.closes and item.closes|length > 1 %} {{ 'up' if item.closes[-1] >= item.closes[0] else 'down' }}{% endif %}">
          <div class="cc-head">
            <span class="cc-name">{{ item.label|e }}</span>
            <span class="cc-last">
              {%- if item.last is not none -%}
                {{ "%.2f"|format(item.last) }}{% if item.kind == "yield" %}%{% endif %}
              {%- else -%}<span class="na">n/a</span>{%- endif -%}
            </span>
          </div>
          <div class="cc-change
            {%- if item.kind == 'yield' and item.change_bp is not none %} {{ 'pos' if item.change_bp >= 0 else 'neg' }}
            {%- elif item.change is not none %} {{ 'pos' if item.change >= 0 else 'neg' }}
            {%- else %} na{%- endif -%}">
            {%- if item.kind == "yield" -%}
              {%- if item.change_bp is not none -%}{{ "%+.1f"|format(item.change_bp) }} bp{%- else -%}—{%- endif -%}
            {%- else -%}
              {%- if item.change is not none -%}{{ "%+.2f"|format(item.change) }}%{%- else -%}—{%- endif -%}
            {%- endif -%}
          </div>
          {% if item.closes and item.closes|length > 1 %}
          <div class="cc-body">
            <canvas class="trend" data-closes='{{ item.closes|tojson }}'
                    data-labels='{{ item.labels|tojson }}'
                    data-kind="{{ item.kind|e }}"></canvas>
          </div>
          {% else %}
          <div class="cc-na">No data available</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <table class="figures">
        <thead>
          <tr><th>Instrument</th><th class="num">Last</th><th class="num">Daily Change</th></tr>
        </thead>
        <tbody>
          {% for item in group["items"] %}
          <tr>
            <td>{{ item.label|e }}</td>
            <td class="num">
              {%- if item.last is not none -%}
                {{ "%.2f"|format(item.last) }}{% if item.kind == "yield" %}%{% endif %}
              {%- else -%}<span class="na">n/a</span>{%- endif -%}
            </td>
            <td class="num">
              {%- if item.kind == "yield" -%}
                {%- if item.change_bp is not none -%}
                  <span class="{{ 'pos' if item.change_bp >= 0 else 'neg' }}">{{ "%+.1f"|format(item.change_bp) }} bp</span>
                {%- else -%}<span class="na">n/a</span>{%- endif -%}
              {%- else -%}
                {%- if item.change is not none -%}
                  <span class="{{ 'pos' if item.change >= 0 else 'neg' }}">{{ "%+.2f"|format(item.change) }}%</span>
                {%- else -%}<span class="na">n/a</span>{%- endif -%}
              {%- endif -%}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  </section>

  <footer class="colophon">
    Daily Market Brief — generated automatically from public news feeds and market data. For information only; not investment advice.
  </footer>
</div>

{% set current_date_js = page_date|tojson %}
{% include "partials/core.js.j2" %}
<script>
(function () {
  // Trend charts — one proper line chart per instrument.
  var UP = "#0d9d6c", DOWN = "#d13438";
  var CHART_FONT = "'Source Sans 3', 'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif";

  function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16),
        g = parseInt(hex.slice(3, 5), 16),
        b = parseInt(hex.slice(5, 7), 16);
    return "rgba(" + r + "," + g + "," + b + "," + alpha + ")";
  }

  document.querySelectorAll("canvas.trend").forEach(function (cv) {
    var closes = JSON.parse(cv.getAttribute("data-closes"));
    if (!closes || closes.length < 2) return;
    var dateLabels = JSON.parse(cv.getAttribute("data-labels") || "[]");
    if (dateLabels.length !== closes.length) {
      dateLabels = closes.map(function (_, i) { return i; });
    }
    var up = closes[closes.length - 1] >= closes[0];
    var color = up ? UP : DOWN;
    new Chart(cv.getContext("2d"), {
      type: "line",
      data: {
        labels: dateLabels,
        datasets: [{
          data: closes,
          borderColor: color,
          borderWidth: 2.2,
          pointRadius: 0,
          pointHitRadius: 10,
          pointHoverRadius: 4,
          pointHoverBackgroundColor: color,
          tension: 0.35,
          fill: true,
          backgroundColor: function (ctx) {
            var area = ctx.chart.chartArea;
            if (!area) return hexToRgba(color, 0.15);
            var grad = ctx.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            grad.addColorStop(0, hexToRgba(color, 0.28));
            grad.addColorStop(1, hexToRgba(color, 0.02));
            return grad;
          }
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            displayColors: false,
            backgroundColor: "rgba(34, 31, 26, .92)",
            titleColor: "#c9a227",
            bodyColor: "#f6f1e4",
            padding: 10,
            cornerRadius: 6,
            titleFont: { family: CHART_FONT, size: 12 },
            bodyFont: { family: CHART_FONT, size: 14, weight: "600" },
            callbacks: {
              title: function (items) {
                return items.length ? String(items[0].label) : "";
              },
              label: function (ctx) {
                var v = ctx.parsed.y;
                return v.toLocaleString(undefined, { maximumFractionDigits: 2 });
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            border: { display: false },
            ticks: {
              autoSkip: true,
              maxTicksLimit: 5,
              maxRotation: 0,
              font: { family: CHART_FONT, size: 10.5 },
              color: "#8d8574",
              padding: 4
            }
          },
          y: {
            position: "right",
            grid: { color: "#ece5d4", drawTicks: false },
            border: { display: false },
            ticks: {
              maxTicksLimit: 4,
              font: { family: CHART_FONT, size: 10.5 },
              color: "#8d8574",
              padding: 4,
              callback: function (v) {
                return v.toLocaleString(undefined, { maximumFractionDigits: 1 });
              }
            }
          }
        }
      }
    });
  });
})();
</script>
</body>
</html>
