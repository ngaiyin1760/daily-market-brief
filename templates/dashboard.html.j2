<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily Market Brief — {{ page_date|e }}</title>
{% include "partials/head.j2" %}
</head>
<body>
<div class="reading-bar" id="reading-bar" aria-hidden="true"></div>
{% set cat_colors = {
  "global-macro": "#4338ca",
  "equity": "#047857",
  "fixed-income": "#92400e",
  "china": "#be123c",
  "hk": "#1d4ed8",
  "tech": "#7c3aed",
  "ai": "#c026d3",
  "semis": "#0e7490",
  "ev": "#65a30d",
  "data-center": "#b45309",
  "space": "#581c87"
} %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>{{ page_date|e }}</h1>
    <div class="generated">Generated {{ generated_at|e }}</div>
  </header>
  {% if snapshot %}
  <div class="ticker-wrap">
    <div class="ticker">{% for t in snapshot %}<span class="{{ t.cls }}">{% if t.m1 == "up" %}<span class="m1 pos" style="animation-delay: {{ loop.index0 * 70 }}ms" title="1-month trend">▲</span>{% elif t.m1 == "down" %}<span class="m1 neg" style="animation-delay: {{ loop.index0 * 70 }}ms" title="1-month trend">▼</span>{% endif %}{{ t.text|e }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</div>
    <div class="asof">Market data as of {{ generated_at|e }}<span class="session-badge" id="session-badge"></span>{% if new_count %}<span class="new-count">{{ new_count }} new {{ "story" if new_count == 1 else "stories" }}</span>{% endif %}</div>
  </div>
  {% endif %}

  {% if hero %}
  <section class="hero reveal" id="snapshot">
    <div class="hero-label">Market Snapshot</div>
    <div class="hero-grid">
      {% for h in hero %}
      <div class="hero-cell">
        <div class="hero-top">
          <span class="hero-name">{{ h.short|e }}</span>
          {% if h.spark %}<svg class="hero-spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><path class="spark-{{ h.m1 or 'flat' }}" d="{{ h.spark }}"/></svg>{% endif %}
        </div>
        <div class="hero-last">{{ h.last_display|e }}</div>
        <div class="hero-chg {{ h.cls }}">{{ h.chg_display|e }}</div>
        {% if h.delta is not none %}<div class="hero-delta {{ 'pos' if h.delta >= 0 else 'neg' }}">Δ {{ h.delta_display|e }} vs yesterday</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if takeaways %}
  <section class="takeaways reveal" id="takeaways">
    <div class="tw-label">Today's Key Takeaways</div>
    <ul>
      {% for t in takeaways %}<li>{{ t|e }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <nav class="cat-nav" id="cat-nav" aria-label="Jump to section">
    <a href="#snapshot" data-target="snapshot">Snapshot</a>
    <a href="#takeaways" data-target="takeaways">Takeaways</a>
    {% for cat in categories %}<a href="#{{ cat.id|e }}" data-target="{{ cat.id|e }}">{{ cat.label|e }}</a>{% endfor %}
  </nav>

  <div class="filter-bar" id="importance-filter" role="group" aria-label="Filter stories by importance">
    <span class="filter-label">Importance</span>
    <button type="button" class="filter-btn active" data-min="0">All</button>
    <button type="button" class="filter-btn" data-min="4">4★+</button>
    <button type="button" class="filter-btn" data-min="3">3★+</button>
    <button type="button" class="filter-btn" data-min="2">2★+</button>
  </div>

  {# ---- News sections first ---- #}
  {% for cat in categories %}
  <section class="desk reveal" id="{{ cat.id|e }}"
           style="--cat: {{ cat_colors.get(cat.id, '#4338ca') }}">
    <h2>{{ cat.label|e }}</h2>
    {% if cat["items"] %}
    <table class="news">
      <thead>
        <tr><th>Headline</th><th>Summary</th><th>Source</th><th>Rating</th><th class="save-col"><span class="visually-hidden">Save</span></th></tr>
      </thead>
      <tbody>
        {% for item in cat["items"] %}
        <tr class="news-item"
            data-url="{{ item.url|e }}"
            data-title="{{ item.title|e }}"
            data-source="{{ item.source|e }}"
            data-category="{{ cat.label|e }}"
            data-rating="{{ item.rating }}"
            data-date="{{ page_date|e }}">
          <td class="headline">
            {% if item.is_new %}<span class="new-badge">NEW</span>{% endif %}
            <a href="{{ item.url|e }}" target="_blank" rel="noopener">{{ item.title|e }}</a>
            {% if item.published %}<div class="pub">{{ item.published|e }}</div>{% endif %}
          </td>
          <td class="summary">
            <ul>
              {% for b in item.bullets %}<li>{{ b|e }}</li>{% endfor %}
            </ul>
          </td>
          <td class="source"><span class="chip">{{ item.source|e }}</span></td>
          <td class="rating">
            <span class="rating-chip r{{ item.rating }}">{{ item.rating }}</span>
            {% if item.reason %}<span class="reason">{{ item.reason|e }}</span>{% endif %}
          </td>
          <td class="save-cell">
            <button type="button" class="save-btn" aria-label="Save this story" title="Save this story">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                <path d="M6.5 2.5h11a1 1 0 0 1 1 1v18l-6.5-4.2-6.5 4.2v-18a1 1 0 0 1 1-1z"
                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty-note">No news available for this category today.</p>
    {% endif %}
  </section>
  {% endfor %}

  <footer class="colophon">
    Daily Market Brief — generated automatically from public news feeds and market data. For information only; not investment advice.
  </footer>
</div>

{% set current_date_js = page_date|tojson %}
{% include "partials/core.js.j2" %}
</body>
</html>
