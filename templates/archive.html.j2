<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Saved Archive — Daily Market Brief</title>
{% include "partials/head.j2" %}
</head>
<body>
{% set is_archive = true %}
{% set cat_colors = {
  "global-macro": "#4338ca",
  "equity": "#047857",
  "fixed-income": "#92400e",
  "china": "#be123c",
  "hk": "#1d4ed8",
  "tech": "#7c3aed",
  "ai": "#c026d3",
  "semis": "#0e7490",
  "ev": "#65a30d",
  "data-center": "#b45309",
  "space": "#581c87"
} %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>Saved Archive</h1>
    <div class="generated">Your saved stories across all briefs</div>
  </header>

    <section class="saved" id="saved">
      <div class="saved-header">
        <div class="archive-title">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="saved-icon">
            <path d="M6.5 2.5h11a1 1 0 0 1 1 1v18l-6.5-4.2-6.5 4.2v-18a1 1 0 0 1 1-1z"
                  fill="currentColor"/>
          </svg>
          <span class="saved-title">Saved Archive</span>
          <span class="saved-count" id="saved-count">0</span>
        </div>
        <div class="saved-header-right">
          <span class="sync-status" id="sync-status"></span>
          <div class="sync-area" id="sync-area">
            <button type="button" class="sync-signin" id="sync-signin">
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path fill="currentColor" d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/>
              </svg>
              Sign in to sync
            </button>
            <div class="sync-user" id="sync-user" style="display:none">
              <img class="sync-avatar" id="sync-avatar" alt="" referrerpolicy="no-referrer" style="display:none">
              <span class="sync-initial" id="sync-initial" style="display:none"></span>
              <span class="sync-label">Synced</span>
              <button type="button" class="sync-signout" id="sync-signout">Sign out</button>
            </div>
          </div>
          <button type="button" class="saved-clear" id="saved-clear">Clear all</button>
        </div>
      </div>
      <div class="saved-body" id="saved-body">
        <p class="saved-empty" id="saved-empty">No saved news yet — tap the bookmark on any story to pin it here.</p>
        <div id="saved-list"></div>
      </div>
    </section>
</div>

{% include "partials/core.js.j2" %}
</body>
</html>
