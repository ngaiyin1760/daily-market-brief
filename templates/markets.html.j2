<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Markets — Daily Market Brief</title>
{% include "partials/head.j2" %}
</head>
<body>
{% set is_markets = true %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>Markets</h1>
    <div class="generated">Key indicators — up to 10 years of daily history · updated {{ generated_at|e }}</div>
  </header>

  <div id="markets-body">
    <p class="empty-note" id="markets-loading">Loading market data…</p>
  </div>

  <footer class="colophon">
    Daily Market Brief — generated automatically from public news feeds and market data. For information only; not investment advice.
  </footer>
</div>

{% include "partials/core.js.j2" %}
<script>
(function () {
  var base = {{ base|tojson }};
  var UP = "#0d9d6c", DOWN = "#d13438";
  var CHART_FONT = "'Source Sans 3', 'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif";
  // Trailing-point windows for the zoom buttons (10y max) and the x-axis
  // tick spacing/format per window (step in trading days).
  var ZOOM_RANGES = { "1M": 22, "3M": 66, "1Y": 262, "5Y": 1305, "10Y": 0 };
  var ZOOM_CFG = {
    // step: 1M = trading-day spacing; 3M/1Y = months; 5Y/10Y = years.
    // Month/year ticks anchor to the 1st trading day of the month/year.
    "1M":  { step: 5,   fmt: "day",   mode: "step" },   // ~1 week between ticks
    "3M":  { step: 1,   fmt: "month", mode: "month" },  // every month
    "1Y":  { step: 2,   fmt: "my",    mode: "month" },  // every 2 months
    "5Y":  { step: 1,   fmt: "year",  mode: "year" },   // every year
    "10Y": { step: 2,   fmt: "year",  mode: "year" }    // every 2 years
  };
  var DEFAULT_ZOOM = "1Y";
  var charts = [];

  function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16),
        g = parseInt(hex.slice(3, 5), 16),
        b = parseInt(hex.slice(5, 7), 16);
    return "rgba(" + r + "," + g + "," + b + "," + alpha + ")";
  }

  function fmtNum(v, kind) {
    return v.toLocaleString(undefined, { maximumFractionDigits: 2 })
      + (kind === "yield" ? "%" : "");
  }

  function makeCard(item) {
    var card = document.createElement("div");
    card.className = "chart-card";
    var chg = item.kind === "yield" ? item.change_bp : item.change;
    var dir = "flat";
    if (chg !== null && chg !== undefined) dir = chg >= 0 ? "up" : "down";
    if (dir !== "flat") card.classList.add(dir);
    var up = dir !== "down";

    var head = document.createElement("div");
    head.className = "cc-head";
    var name = document.createElement("span");
    name.className = "cc-name";
    name.textContent = item.label;
    var last = document.createElement("span");
    last.className = "cc-last";
    last.textContent = (item.last !== null && item.last !== undefined)
      ? fmtNum(item.last, item.kind) : "n/a";
    head.appendChild(name);
    head.appendChild(last);
    card.appendChild(head);

    var change = document.createElement("div");
    change.className = "cc-change " + (chg === null || chg === undefined ? "na" : (chg >= 0 ? "pos" : "neg"));
    if (chg === null || chg === undefined) {
      change.textContent = "—";
    } else if (item.kind === "yield") {
      change.textContent = (chg >= 0 ? "+" : "") + chg.toFixed(1) + " bp";
    } else {
      change.textContent = (chg >= 0 ? "+" : "") + chg.toFixed(2) + "%";
    }
    card.appendChild(change);

    var closes = item.closes || [];
    var labels = item.labels || [];
    if (labels.length !== closes.length) {
      labels = closes.map(function (_, i) { return i; });
    }
    if (closes.length >= 2) {
      // Full series is kept on the chart; the default view is DEFAULT_ZOOM.
      var total = closes.length;
      var defWin = ZOOM_RANGES[DEFAULT_ZOOM] || 0;
      var defLo = (defWin > 0 && defWin < total) ? total - defWin : 0;

      var body = document.createElement("div");
      body.className = "cc-body";
      var cv = document.createElement("canvas");
      body.appendChild(cv);
      card.appendChild(body);

      var bar = document.createElement("div");
      bar.className = "zoom-bar";
      Object.keys(ZOOM_RANGES).forEach(function (key) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "zoom-btn" + (key === DEFAULT_ZOOM ? " active" : "");
        b.textContent = key;
        b.setAttribute("aria-pressed", key === DEFAULT_ZOOM ? "true" : "false");
        b.addEventListener("click", function () {
          setZoom(chart, key);
          bar.querySelectorAll(".zoom-btn").forEach(function (x) {
            var on = x === b;
            x.classList.toggle("active", on);
            x.setAttribute("aria-pressed", on ? "true" : "false");
          });
        });
        bar.appendChild(b);
      });
      card.appendChild(bar);

      var chart = new Chart(cv.getContext("2d"), {
        type: "line",
        data: {
          labels: labels.slice(defLo),
          datasets: [{
            data: closes.slice(defLo),
            borderColor: up ? UP : DOWN,
            borderWidth: 1.8,
            pointRadius: 0,
            pointHitRadius: 10,
            pointHoverRadius: 4,
            pointHoverBackgroundColor: up ? UP : DOWN,
            tension: 0.35,
            fill: true,
            backgroundColor: function (ctx) {
              var area = ctx.chart.chartArea;
              if (!area) return hexToRgba(up ? UP : DOWN, 0.15);
              var grad = ctx.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
              grad.addColorStop(0, hexToRgba(up ? UP : DOWN, 0.28));
              grad.addColorStop(1, hexToRgba(up ? UP : DOWN, 0.02));
              return grad;
            }
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              displayColors: false,
              backgroundColor: "rgba(34, 31, 26, .92)",
              titleColor: "#c9a227",
              bodyColor: "#f6f1e4",
              padding: 10,
              cornerRadius: 6,
              titleFont: { family: CHART_FONT, size: 12 },
              bodyFont: { family: CHART_FONT, size: 14, weight: "600" },
              callbacks: {
                title: function (items) {
                  return items.length ? String(items[0].label) : "";
                },
                label: function (ctx) {
                  var v = ctx.parsed.y;
                  return v.toLocaleString(undefined, { maximumFractionDigits: 2 });
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: {
                autoSkip: false,
                source: "data",
                maxRotation: 0,
                font: { family: CHART_FONT, size: 10.5 },
                color: "#8d8574",
                padding: 4,
                // Labels adapt to the active zoom window so ticks never
                // collapse into repeated month codes (1M) or overlap (10Y).
                callback: function (value) {
                  var chart = this.chart;
                  var key = (chart && chart._zoomKey) || DEFAULT_ZOOM;
                  var cfg = ZOOM_CFG[key] || ZOOM_CFG[DEFAULT_ZOOM];
                  var label = String(this.getLabelForValue(value));
                  var m = label.match(/^([A-Z][a-z]{2})\s+(\d+)(?:\s+'(\d{2}))?$/);
                  if (!m) return label;
                  var mon = m[1], day = m[2], yy = m[3];
                  // Year of the NEXT data point: if it differs, this tick is
                  // the last of its year — show the year to mark the change
                  // (e.g. "Dec '25 · Jan · Feb").
                  var nextYY = null;
                  if (chart && chart.data && chart.data.labels) {
                    var nextLbl = chart.data.labels[value + 1];
                    var nm = nextLbl && nextLbl.match(/'(\d{2})$/);
                    if (nm) nextYY = nm[1];
                  }
                  if (cfg.fmt === "day") {
                    return (nextYY && nextYY !== yy)
                      ? mon + " " + day + " '" + yy : mon + " " + day;
                  }
                  if (cfg.fmt === "month") {
                    // Month ticks sit on the 1st; mark the year exactly once
                    // at its January tick (e.g. "Jan '26").
                    return mon === "Jan" ? mon + " '" + yy : mon;
                  }
                  if (cfg.fmt === "my") {
                    return mon + " '" + yy;
                  }
                  return yy ? "20" + yy : label;
                }
              },
              // Category scales build one tick per point; replace them with
              // an exact stepped subset for the active zoom window so the
              // labels never overlap.
              afterBuildTicks: buildZoomTicks
            },
            y: {
              position: "right",
              grid: { color: "#ece5d4", drawTicks: false },
              border: { display: false },
              ticks: {
                maxTicksLimit: 4,
                font: { family: CHART_FONT, size: 10.5 },
                color: "#8d8574",
                padding: 4,
                callback: function (v) {
                  return v.toLocaleString(undefined, { maximumFractionDigits: 1 });
                }
              }
            }
          }
        }
      });
      charts.push(chart);
      chart._fullLabels = labels;
      chart._fullCloses = closes;
      chart._zoomKey = DEFAULT_ZOOM;
    } else {
      var na = document.createElement("div");
      na.className = "cc-na";
      na.textContent = "No data available";
      card.appendChild(na);
    }
    return card;
  }

  // Slice the chart data to the zoom window (this also re-fits the y-axis
  // to the visible range) and let afterBuildTicks emit the stepped x labels.
  function setZoom(chart, key) {
    chart._zoomKey = key;
    var total = chart._fullLabels.length;
    var win = ZOOM_RANGES[key] || 0;
    var lo = 0;
    if (win > 0 && win < total) lo = total - win;
    chart.data.labels = chart._fullLabels.slice(lo);
    chart.data.datasets[0].data = chart._fullCloses.slice(lo);
    chart.update();
  }

  var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

  function parseDate(label) {
    var m = String(label).match(/^([A-Z][a-z]{2})\s+(\d+)(?:\s+'(\d{2}))?$/);
    if (!m) return null;
    var mi = MONTHS.indexOf(m[1]);
    if (mi < 0) return null;
    return { y: parseInt(m[3] || "0", 10), mon: mi, day: parseInt(m[2], 10) };
  }

  // Month/year ticks land on the FIRST trading day of their month/year,
  // anchored at the newest boundary and stepping back so the most recent
  // months/years are always represented.
  function buildBoundaryTicks(labels, cfg) {
    var first = parseDate(labels[0]);
    var last = parseDate(labels[labels.length - 1]);
    if (!first || !last) return null;
    var stepMonths = cfg.step * (cfg.mode === "year" ? 12 : 1);
    var bounds = [];
    var y = last.y, m = (cfg.mode === "year") ? 0 : last.mon;
    for (;;) {
      if (y < first.y || (y === first.y && m < first.mon)) break;
      bounds.push({ y: y, m: m });
      var total = y * 12 + m - stepMonths;
      y = Math.floor(total / 12);
      m = total - y * 12;
    }
    bounds.reverse();
    var ticks = [];
    for (var b = 0; b < bounds.length; b++) {
      var target = bounds[b].y * 12 + bounds[b].m;
      var tickIndex = -1;
      for (var i = 0; i < labels.length; i++) {
        var d = parseDate(labels[i]);
        if (d && d.y * 12 + d.mon >= target) { tickIndex = i; break; }
      }
      if (tickIndex < 0) continue;
      // Month ticks: drop a boundary that falls on the window's first point
      // when the window starts more than a week into that month — it's a
      // partial month, and the tick would sit mid-month instead of on the 1st.
      if (cfg.mode === "month" && tickIndex === 0 && first.day > 7) continue;
      ticks.push({ value: tickIndex });
    }
    return ticks;
  }

  // Category scales build one tick per data point; we replace them with a
  // small exact subset for the active zoom so labels never overlap.
  function buildZoomTicks(axis) {
    var chart = axis.chart;
    var key = (chart && chart._zoomKey) || DEFAULT_ZOOM;
    var cfg = ZOOM_CFG[key] || ZOOM_CFG[DEFAULT_ZOOM];
    var labels = axis.getLabels();
    var n = labels.length;
    if (!n) return;
    var ticks = null;
    if (cfg.mode !== "step") ticks = buildBoundaryTicks(labels, cfg);
    if (!ticks) {
      // Fixed trading-day spacing (1M) or fallback when labels don't parse.
      ticks = [];
      for (var i = 0; i < n; i += cfg.step) ticks.push({ value: i });
      var lastv = ticks.length ? ticks[ticks.length - 1].value : -1;
      // Include the newest point unless it would land right next to an
      // existing tick (adjacent labels look like duplicates).
      if (n - 1 - lastv >= Math.max(1, Math.floor(cfg.step / 2))) {
        ticks.push({ value: n - 1 });
      }
    }
    axis.ticks = ticks;
  }

  function makeFigures(group) {
    var table = document.createElement("table");
    table.className = "figures";
    var thead = document.createElement("thead");
    var htr = document.createElement("tr");
    ["Instrument", "Last", "Daily Change"].forEach(function (h, i) {
      var th = document.createElement("th");
      if (i > 0) th.className = "num";
      th.textContent = h;
      htr.appendChild(th);
    });
    thead.appendChild(htr);
    table.appendChild(thead);
    var tbody = document.createElement("tbody");
    group.items.forEach(function (item) {
      var tr = document.createElement("tr");
      var tdName = document.createElement("td");
      tdName.textContent = item.label;
      tr.appendChild(tdName);
      var tdLast = document.createElement("td");
      tdLast.className = "num";
      tdLast.textContent = (item.last !== null && item.last !== undefined)
        ? fmtNum(item.last, item.kind) : "n/a";
      tr.appendChild(tdLast);
      var tdChg = document.createElement("td");
      tdChg.className = "num";
      var chg = item.kind === "yield" ? item.change_bp : item.change;
      if (chg === null || chg === undefined) {
        var na = document.createElement("span");
        na.className = "na";
        na.textContent = "n/a";
        tdChg.appendChild(na);
      } else {
        var span = document.createElement("span");
        span.className = chg >= 0 ? "pos" : "neg";
        span.textContent = item.kind === "yield"
          ? (chg >= 0 ? "+" : "") + chg.toFixed(1) + " bp"
          : (chg >= 0 ? "+" : "") + chg.toFixed(2) + "%";
        tdChg.appendChild(span);
      }
      tr.appendChild(tdChg);
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    return table;
  }

  function render(data) {
    var host = document.getElementById("markets-body");
    host.innerHTML = "";
    (data.groups || []).forEach(function (group) {
      var sec = document.createElement("section");
      sec.className = "desk";
      var h2 = document.createElement("h2");
      h2.textContent = group.name;
      sec.appendChild(h2);
      var grid = document.createElement("div");
      grid.className = "chart-grid";
      (group.items || []).forEach(function (item) {
        grid.appendChild(makeCard(item));
      });
      sec.appendChild(grid);
      sec.appendChild(makeFigures(group));
      host.appendChild(sec);
    });
    if (!host.children.length) {
      host.innerHTML = '<p class="empty-note">No indicator data available yet.</p>';
    }
  }

  fetch(base + "/data/indicators.json")
    .then(function (r) {
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    })
    .then(render)
    .catch(function (e) {
      console.error("Failed to load market data:", e);
      document.getElementById("markets-body").innerHTML =
        '<p class="empty-note">Market data unavailable — check back after the next daily run.</p>';
    });
})();
</script>
</body>
</html>
