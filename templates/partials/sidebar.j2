<aside class="sidebar">
  <button type="button" class="sidebar-toggle" id="sidebar-toggle"
          aria-label="Collapse sidebar" title="Collapse sidebar" aria-expanded="true">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="site-title">Daily Market Brief</div>
  <div class="site-sub">Market Intelligence</div>
  <button type="button" class="theme-toggle" id="theme-toggle"
          aria-label="Toggle dark mode" title="Toggle dark mode" aria-pressed="false">
    <!-- Sun (shown in dark mode: tap to go light) -->
    <svg class="theme-icon icon-sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
      <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <!-- Moon (shown in light mode: tap to go dark) -->
    <svg class="theme-icon icon-moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.77-9.22A8.97 8.97 0 0 0 12 3z" fill="currentColor"/>
    </svg>
  </button>
  <nav class="sidebar-top">
    <a class="archive-link{% if is_markets | default(false) %} active{% endif %}"
       href="{{ base }}/markets.html"{% if is_markets | default(false) %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M4 19V9M10 19V5M16 19v-7M22 19H2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Markets</span>
    </a>
    <a class="archive-link{% if is_analytics | default(false) %} active{% endif %}"
       href="{{ base }}/analytics.html"{% if is_analytics | default(false) %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M3 3v18h18M7 15l4-4 3 3 5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Analytics</span>
    </a>
    <a class="archive-link{% if is_repo_radar | default(false) %} active{% endif %}"
       href="{{ base }}/repo-radar.html"{% if is_repo_radar | default(false) %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M8 3a2 2 0 0 0-2 2v6a2 2 0 0 1-2 2 2 2 0 0 1 2 2v6a2 2 0 0 0 2 2M16 3a2 2 0 0 1 2 2v6a2 2 0 0 0 2 2 2 2 0 0 0-2 2v6a2 2 0 0 1-2 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Repo Radar</span>
    </a>
    <a class="archive-link{% if is_search | default(false) %} active{% endif %}"
       href="{{ base }}/search.html"{% if is_search | default(false) %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.1l4.5 4.5-1.42 1.42-4.5-4.5A7.5 7.5 0 1 1 10.5 3zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z" fill="currentColor"/>
      </svg>
      <span>Search</span>
    </a>
    <a class="archive-link{% if is_archive | default(false) %} active{% endif %}"
       href="{{ base }}/archive.html"{% if is_archive | default(false) %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M6.5 2.5h11a1 1 0 0 1 1 1v18l-6.5-4.2-6.5 4.2v-18a1 1 0 0 1 1-1z"
              fill="currentColor"/>
      </svg>
      <span>Archive</span>
    </a>
  </nav>
  <nav id="date-nav"><a href="#" class="na">Loading…</a></nav>
</aside>
