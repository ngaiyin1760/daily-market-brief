<meta name="theme-color" content="#4338ca">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Market Brief">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="manifest" href="{{ base }}/site.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="{{ base }}/icons/favicon-32.png">
<link rel="apple-touch-icon" href="{{ base }}/icons/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9"></script>
<!-- Firebase compat SDK (deferred: a slow CDN never blocks page render).
     If these fail to load, the page works exactly as before, localStorage only. -->
<script defer src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script defer src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script defer src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<style>
  :root {
    --sidebar-w: 230px;
    --paper: #f7f2e9;
    --card: #fffdf8;
    --ink: #221f1a;
    --ink-soft: #514c42;
    --muted: #8d8574;
    --rule: #e0d8c6;
    --rule-dark: #b6ab92;
    --accent: #4338ca;          /* deep indigo */
    --accent-2: #0f766e;        /* teal */
    --gold: #c9a227;
    --green: #0d9d6c;
    --red: #d13438;
    --serif: 'Playfair Display', Garamond, Cambria, Georgia, serif;
    --sans: 'Source Sans 3', 'Segoe UI', -apple-system, 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--sans);
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
    font-size: 16px;
  }

  /* Reading progress bar (top of page) */
  .reading-bar {
    position: fixed;
    top: 0; left: 0;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--gold));
    z-index: 1000;
    pointer-events: none;
    transition: width .08s linear;
  }

  /* ---------- Sidebar ---------- */
  .sidebar {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--sidebar-w);
    background: linear-gradient(180deg, #171233 0%, #241a4d 60%, #1c1440 100%);
    color: #cfc9bb;
    padding: 28px 0;
    overflow-y: auto;
    border-right: 1px solid #0d0a1f;
  }
  .sidebar .site-title {
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 700;
    color: #f6f1e4;
    padding: 0 22px 16px;
    border-bottom: 1px solid rgba(201, 162, 39, .35);
    margin-bottom: 6px;
    letter-spacing: .01em;
  }
  /* Sidebar collapse/expand (desktop only) */
  .sidebar-toggle {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: none;
    border: 1px solid rgba(246, 241, 228, .25);
    color: #cfc9bb;
    cursor: pointer;
    transition: background .12s, color .12s, border-color .12s;
  }
  .sidebar-toggle:hover {
    background: rgba(255, 255, 255, .08);
    color: #f6f1e4;
    border-color: rgba(246, 241, 228, .5);
  }
  .sidebar-reopen {
    position: fixed;
    top: 14px;
    left: 14px;
    z-index: 900;
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--card);
    border: 1px solid var(--rule-dark);
    color: var(--ink-soft);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(34, 31, 26, .15);
    transition: color .12s, border-color .12s, transform .12s;
  }
  .sidebar-reopen:hover { color: var(--accent); border-color: var(--accent); }
  .sidebar-reopen:active { transform: scale(.94); }
  .sidebar-collapsed .sidebar { display: none; }
  .sidebar-collapsed .content { margin-left: 0; }
  .sidebar .site-sub {
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 0 22px 16px;
  }
  .sidebar nav { padding-top: 8px; }
  .sidebar nav a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 22px;
    color: #b0a898;
    text-decoration: none;
    font-size: 14.5px;
    border-left: 3px solid transparent;
    transition: background .12s, color .12s, border-color .12s;
  }
  .read-dot {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, .10), 0 1px 2px rgba(0, 0, 0, .4);
  }
  .read-dot.dot-red { background: #d13438; }
  .read-dot.dot-yellow { background: #e6a700; }
  .read-dot.dot-green { background: #0d9d6c; }
  .sidebar nav a:hover { background: rgba(255, 255, 255, .06); color: #f4eedd; }
  .sidebar nav a.active {
    background: rgba(201, 162, 39, .14);
    color: #f8f3e6;
    border-left-color: var(--gold);
    font-weight: 600;
  }

  /* ---------- Content ---------- */
  .content {
    margin-left: var(--sidebar-w);
    padding: 34px 44px 80px;
    max-width: 1240px;
  }

  /* Masthead band */
  header.masthead {
    background: linear-gradient(120deg, #241a4d 0%, #4338ca 55%, #0f766e 130%);
    border-radius: 8px;
    color: #f6f1e4;
    padding: 30px 34px 26px;
    margin-bottom: 0;
    box-shadow: 0 3px 14px rgba(36, 26, 77, .25);
  }
  header.masthead .kicker {
    font-size: 12px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 8px;
  }
  header.masthead h1 {
    font-family: var(--serif);
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
  }
  header.masthead .generated {
    color: rgba(246, 241, 228, .72);
    font-size: 14px;
    font-style: italic;
    margin-top: 8px;
  }

  /* Snapshot ticker strip */
  .ticker-wrap {
    border-bottom: 1px solid var(--rule-dark);
    margin-bottom: 30px;
  }
  .ticker {
    padding: 10px 4px 6px;
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .06em;
    color: var(--ink-soft);
    font-variant: small-caps;
    white-space: nowrap;
    overflow-x: auto;
  }
  .ticker .m1 { font-size: 11px; margin-right: 2px; }
  .ticker .m1.pos { color: var(--green); }
  .ticker .m1.neg { color: var(--red); }
  .ticker .m1 {
    animation: m1-in .5s ease both;
  }
  @keyframes m1-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Data freshness note + live session badge */
  .asof {
    font-size: 12.5px;
    color: var(--muted);
    font-style: italic;
  }
  .ticker-wrap .asof { padding: 0 4px 10px; }
  .desk .asof { margin: -4px 0 16px; }
  .session-badge {
    display: inline-block;
    background: rgba(67, 56, 202, .08);
    border: 1px solid #d4c8f2;
    color: #4c3d8f;
    border-radius: 999px;
    padding: 1px 10px;
    font-size: 11.5px;
    font-weight: 600;
    font-style: normal;
    margin-left: 6px;
  }
  /* The Markets masthead is a dark gradient — the badge there needs light
     colors so it doesn't blend into the background. */
  header.masthead .session-badge {
    background: rgba(246, 241, 228, .12);
    border-color: rgba(246, 241, 228, .35);
    color: #f6f1e4;
  }
  .new-count {
    display: inline-block;
    background: rgba(13, 157, 108, .12);
    border: 1px solid rgba(13, 157, 108, .35);
    color: #0b7a53;
    border-radius: 999px;
    padding: 0 9px;
    font-size: 11.5px;
    font-weight: 600;
    font-style: normal;
    margin-left: 8px;
  }

  /* Market Snapshot hero card */
  .hero {
    background: var(--card);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--gold);
    border-radius: 6px;
    box-shadow: 0 2px 10px rgba(34, 31, 26, .08);
    padding: 16px 18px 18px;
    margin-bottom: 32px;
  }
  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #6b5510;
    margin-bottom: 12px;
  }
  /* Collapsible hero: header row is the toggle; grid hidden until opened. */
  .hero-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--sans);
    text-align: left;
  }
  .hero-toggle .chevron {
    color: var(--gold);
    flex: 0 0 auto;
    transition: transform .2s ease;
  }
  .hero.open .hero-toggle .chevron { transform: rotate(90deg); }
  .hero-toggle .hero-label { margin-bottom: 0; }
  .hero-hint {
    font-size: 11.5px;
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    margin-left: 2px;
  }
  .hero-grid { display: none; }
  .hero.open .hero-grid { display: grid; }
  .hero-grid {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }
  .hero-cell {
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 10px 12px;
    background: linear-gradient(180deg, #fdfaf3, #f7f2e9);
  }
  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .hero-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--ink);
  }
  .hero-spark {
    width: 58px;
    height: 18px;
    flex: 0 0 auto;
    overflow: visible;
  }
  .hero-spark path {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-spark .spark-up { stroke: var(--green); }
  .hero-spark .spark-down { stroke: var(--red); }
  .hero-spark .spark-flat { stroke: var(--muted); }
  .hero-last {
    font-size: 17px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-top: 4px;
  }
  .hero-chg {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hero-delta {
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-top: 1px;
  }

  /* ---------- Key Takeaways ---------- */
  .takeaways {
    background: linear-gradient(135deg, #f1ecfd 0%, #e9f6f2 100%);
    border: 1px solid #d4c8f2;
    border-left: 5px solid var(--accent);
    border-radius: 6px;
    padding: 20px 26px 16px;
    margin-bottom: 40px;
    box-shadow: 0 2px 8px rgba(67, 56, 202, .10);
  }
  .takeaways .tw-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .takeaways ul { margin: 0; padding-left: 20px; }
  .takeaways li {
    margin-bottom: 8px;
    font-size: 16.5px;
    line-height: 1.45;
  }
  .takeaways li::marker { color: var(--gold); }

  /* ---------- Saved news (localStorage) ---------- */
  .visually-hidden {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .saved {
    background: linear-gradient(135deg, #f5f2ea 0%, #efe9f9 100%);
    border: 1px solid #d9cfae;
    border-left: 5px solid var(--gold);
    border-radius: 6px;
    margin-bottom: 26px;
    box-shadow: 0 2px 8px rgba(120, 95, 20, .10);
  }
  .saved-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 18px;
  }
  .saved-icon { color: var(--gold); }
  .saved-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #6b5510;
  }
  .saved-count {
    background: var(--gold);
    color: #241a08;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    min-width: 22px;
    padding: 1px 7px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .saved-clear {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 6px 4px;
    min-height: 44px;
  }
  .saved-clear:hover { color: var(--red); }

  /* ---------- Pinned Archive link (sidebar, above the date list) ---------- */
  .sidebar-top {
    border-bottom: 1px solid #3a3d44;
    margin-bottom: 8px;
    padding-bottom: 8px;
  }
  .sidebar .archive-link {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 22px;
    color: #e8dfc9;
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background .12s, color .12s, border-color .12s;
  }
  .sidebar .archive-link svg { color: var(--gold); flex: 0 0 auto; }
  .sidebar .archive-link:hover { background: rgba(255, 255, 255, .06); color: #fff; }
  .sidebar .archive-link.active {
    background: rgba(201, 162, 39, .14);
    color: #f8f3e6;
    border-left-color: var(--gold);
  }
  .archive-title {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 4px;
    min-height: 44px;
  }
  .sync-status {
    font-size: 12.5px;
    color: var(--muted);
    font-style: italic;
  }
  .sync-status.sync-status-err { color: var(--red); font-style: normal; font-weight: 600; }

  /* Firebase sync auth UI */
  .saved-header-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sync-area { display: flex; align-items: center; }
  .sync-signin {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 8px 16px;
    min-height: 40px;
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background .12s, transform .12s;
  }
  .sync-signin:hover { background: #372ea6; }
  .sync-signin:active { transform: scale(.97); }
  .sync-user { display: flex; align-items: center; gap: 8px; }
  .sync-avatar { width: 24px; height: 24px; border-radius: 50%; }
  .sync-initial {
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sync-label { font-size: 12.5px; color: var(--green); font-weight: 600; }
  .sync-signout {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 6px 4px;
    min-height: 40px;
  }
  .sync-signout:hover { color: var(--red); }
  .saved-body { padding: 0 18px 14px; }
  .saved-empty { color: var(--muted); font-style: italic; font-size: 14.5px; margin: 4px 0 6px; }
  .saved-group { margin-top: 10px; }
  .saved-group h4 {
    margin: 0 0 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
  }
  .saved-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
  }
  .saved-group .saved-item:last-child { border-bottom: none; }
  .saved-item .si-headline a {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .saved-item .si-headline a:hover { color: var(--accent); text-decoration: underline; }
  .saved-item .si-meta {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 3px;
  }
  .saved-item .si-stars { color: var(--gold); letter-spacing: .06em; margin-left: 6px; }
  .saved-item .si-remove {
    flex: 0 0 auto;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 16px;
    line-height: 1;
    padding: 10px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 6px;
  }
  .saved-item .si-remove:hover { color: var(--red); background: rgba(209, 52, 56, .08); }

  /* Save toggle button on each news row */
  .save-col { width: 44px; }
  td.save-cell { width: 44px; text-align: center; }
  .save-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #b6ab92;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
    border-radius: 6px;
    transition: color .12s, background .12s, transform .12s;
  }
  .save-btn:hover { color: var(--gold); background: rgba(201, 162, 39, .12); }
  .save-btn.saved { color: var(--gold); }
  .save-btn.saved svg path { fill: var(--gold); }
  .save-btn.saved { animation: save-pop .35s ease; }
  @keyframes save-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .save-btn:active { transform: scale(1.15); }

  /* NEW badge on first-appearance stories */
  .new-badge {
    display: inline-block;
    background: #0d9d6c;
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    border-radius: 4px;
    padding: 1px 6px;
    margin-right: 7px;
    vertical-align: 2px;
  }

  /* ---------- Sections ---------- */
  section.desk { margin-bottom: 44px; }
  section.desk > h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--cat, var(--accent));
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-dark);
  }
  section.desk > h2::before {
    content: "";
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 2px;
    background: var(--cat, var(--accent));
    margin-right: 9px;
  }
  section.desk > h2::after {
    content: "";
    display: block;
    width: 56px;
    border-bottom: 3px solid var(--cat, var(--accent));
    margin-top: 6px;
    margin-bottom: -9px;
  }

  /* News table */
  table.news { width: 100%; border-collapse: collapse; }
  table.news th, table.news td {
    text-align: left;
    padding: 14px 14px 14px 8px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  table.news th {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    padding-top: 10px;
    padding-bottom: 6px;
  }
  table.news tbody tr { transition: background .12s; }
  table.news tbody tr:nth-child(even) { background: rgba(67, 56, 202, .025); }
  table.news tbody tr:hover { background: rgba(201, 162, 39, .09); }
  table.news tr:last-child td { border-bottom: none; }
  td.headline { width: 30%; }
  td.headline a {
    font-family: var(--serif);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 17.5px;
    line-height: 1.3;
  }
  td.headline a:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; }
  td.headline .pub { font-size: 12.5px; color: var(--muted); font-style: italic; margin-top: 5px; }
  td.summary ul { margin: 0; padding-left: 18px; }
  td.summary li { margin-bottom: 5px; font-size: 15px; color: var(--ink-soft); }
  td.source { white-space: nowrap; }
  td.source .chip {
    display: inline-block;
    background: #efe9f9;
    color: #4c3d8f;
    border: 1px solid #ddd2f2;
    border-radius: 999px;
    padding: 2px 11px;
    font-size: 12.5px;
    font-style: normal;
  }
  td.rating { white-space: nowrap; }
  .rating-chip {
    display: inline-block;
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 12.5px;
    font-weight: 700;
    color: #fff;
    min-width: 26px;
