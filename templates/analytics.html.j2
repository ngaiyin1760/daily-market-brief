<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Analytics — Daily Market Brief</title>
{% include "partials/head.j2" %}
</head>
<body>
<div class="reading-bar" id="reading-bar" aria-hidden="true"></div>
{% set is_analytics = true %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Daily Market Brief</div>
    <h1>Analytics</h1>
    <div class="generated">Today's top {{ daily_max }} from your blogs · tech &amp; engineering scope · updated {{ generated_at|e }}</div>
  </header>

  {% if days %}
  <div class="day-jump-wrap">
    <label for="day-jump">Jump to</label>
    <select id="day-jump" class="day-jump">
      {% for d in days %}<option value="{{ d.date|e }}">{{ d.date|e }}{% if loop.first %} (latest){% endif %}</option>{% endfor %}
    </select>
  </div>

  {% for d in days %}
  <details class="day-group" id="day-{{ d.date|e }}"{% if loop.first %} open{% endif %}>
    <summary class="day-bar">
      <svg class="day-chevron" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="day-date">{{ d.date|e }}</span>
      {% if loop.first %}<span class="day-tag">Today</span>{% endif %}
      <span class="day-meta">{{ d.post_count }} post(s) · {{ d.blogs|length }} blog(s)</span>
    </summary>
    <div class="day-body">
      {% for b in d.blogs %}
      <section class="desk reveal">
        <h2>{{ b.name|e }}</h2>
        {% for post in b.posts %}
        <article class="blog-card">
          <div class="bc-head">
            {% if post.preview %}<span class="preview-tag">preview only</span>{% endif %}
            {% if post.read_time %}<span class="chip read-time-chip">{{ post.read_time }} min</span>{% endif %}
          </div>
          <h3><a href="{{ post.link|e }}" target="_blank" rel="noopener">{{ post.title|e }}</a></h3>
          {% if post.published %}<div class="pub">{{ post.published|e }}</div>{% endif %}
          {% if post.bullets %}
          <ul class="bc-bullets">
            {% for bl in post.bullets %}<li>{{ bl|e }}</li>{% endfor %}
          </ul>
          {% endif %}
          <div class="bc-footer">
            <div class="bc-url"><a href="{{ post.link|e }}" target="_blank" rel="noopener">{{ post.link|e }}</a></div>
            <button type="button" class="save-btn" aria-label="Save this post" title="Save this post"
                    data-save-url="{{ post.link|e }}"
                    data-save-title="{{ post.title|e }}"
                    data-save-source="{{ post.blog|e }}"
                    data-save-category="Analytics"
                    data-save-rating="{{ post.rating }}"
                    data-save-date="{{ d.date|e }}">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                <path d="M6.5 2.5h11a1 1 0 0 1 1 1v18l-6.5-4.2-6.5 4.2v-18a1 1 0 0 1 1-1z"
                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </article>
        {% endfor %}
      </section>
      {% endfor %}
    </div>
  </details>
  {% endfor %}
  {% else %}
  <p class="empty-note">No blog updates yet — the history fills in once blogs start publishing.</p>
  {% endif %}

  <footer class="colophon">
    Daily Market Brief — generated automatically from public news feeds and market data. For information only; not investment advice.
  </footer>
</div>

{% include "partials/core.js.j2" %}
</body>
</html>
