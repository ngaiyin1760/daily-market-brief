<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Outlook Autopilot — Daily Market Brief</title>
{% include "partials/head.j2" %}
<style>
  .ap-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(34, 31, 26, .08);
    padding: 18px 22px;
    margin-bottom: 26px;
  }
  .ap-card h3 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 4px;
  }
  .ap-card h3 .ap-count {
    color: var(--muted);
    letter-spacing: .04em;
    font-weight: 600;
    margin-left: 6px;
  }
  .ap-card .ap-sub {
    font-size: 13px;
    color: var(--muted);
    font-style: italic;
    margin: 0 0 14px;
  }
  table.ap-table { width: 100%; border-collapse: collapse; }
  table.ap-table th, table.ap-table td {
    text-align: left;
    padding: 9px 10px 9px 4px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    font-size: 14.5px;
  }
  table.ap-table th {
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    padding-top: 6px;
    padding-bottom: 4px;
  }
  table.ap-table tr:last-child td { border-bottom: none; }
  td.ap-addr { font-family: ui-monospace, Consolas, monospace; font-size: 13.5px; }
  td.ap-name { font-weight: 600; white-space: nowrap; }
  td.ap-notes { color: var(--muted); }
  .ap-badge {
    display: inline-block;
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 11.5px;
    font-weight: 700;
    white-space: nowrap;
  }
  .ap-badge.learned { background: #0f766e; color: #fff; }
  .ap-badge.keep { background: rgba(13, 157, 108, .12); color: #0b7a53; border: 1px solid rgba(13,157,108,.35); }
  .ap-badge.auto { background: #efe9f9; color: #4c3d8f; border: 1px solid #ddd2f2; }
  .ap-pattern {
    font-family: ui-monospace, Consolas, monospace;
    background: rgba(67, 56, 202, .07);
    border: 1px solid #d4c8f2;
    border-radius: 5px;
    padding: 1px 7px;
    font-size: 13.5px;
  }
  .ap-learned-empty { color: var(--muted); font-style: italic; font-size: 14px; }
  .ap-pill {
    display: inline-block;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 13px;
    font-weight: 700;
    margin: 2px 8px 2px 0;
  }
  .ap-pill.ok { background: rgba(13, 157, 108, .12); color: #0b7a53; border: 1px solid rgba(13,157,108,.35); }
  .ap-pill.failed { background: rgba(200, 40, 40, .10); color: #b02a2a; border: 1px solid rgba(200,40,40,.35); }
  .ap-pill.unknown { background: rgba(120, 110, 90, .12); color: var(--muted); border: 1px solid var(--rule); }
  .ap-refresh-btn {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    margin-top: 10px;
  }
  .ap-refresh-btn:hover { filter: brightness(1.1); color: #fff; }
  .ap-foot {
    font-size: 13px;
    color: var(--muted);
    font-style: italic;
    margin-top: 4px;
  }
  .ap-foot code {
    background: rgba(67, 56, 202, .07);
    border-radius: 4px;
    padding: 1px 5px;
  }
  @media (max-width: 820px) {
    .ap-card { padding: 14px 14px; overflow-x: hidden; }
    /* Long addresses are the main overflow culprit — let them wrap anywhere. */
    table.ap-table { table-layout: fixed; }
    td.ap-addr, .ap-pattern, .ap-card code {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    table.ap-table th, table.ap-table td {
      font-size: 13.5px;
      padding: 7px 6px 7px 2px;
    }
    td.ap-name { white-space: normal; }
    .ap-refresh-btn { display: block; text-align: center; }
    .ap-pill { font-size: 12px; }
  }
</style>
</head>
<body>
<div class="reading-bar" id="reading-bar" aria-hidden="true"></div>
{% set is_autopilot = true %}
{% include "partials/sidebar.j2" %}

<div class="content">
  <header class="masthead">
    <div class="kicker">Outlook Autopilot</div>
    <h1>Email Rules</h1>
    <div class="generated">
      {% if autopilot_rules %}Updated {{ autopilot_rules.updated }}{% else %}Not yet synced — run scripts/sync_autopilot.py{% endif %}
      &middot; source of truth: <code style="background:rgba(246,241,228,.14);border-radius:4px;padding:1px 6px;">outlook-autopilot/rules/auto_mark_list.md</code>
    </div>
  </header>

  {% if not autopilot_rules %}
  <div class="ap-card">
    <h3>Token health &amp; sign-in</h3>
    <p class="ap-sub">Google sign-ins expire roughly weekly — click below to refresh them (one browser sign-in per account, everything else is automatic).</p>
    <a class="ap-refresh-btn" href="outlook-autopilot:refresh-tokens">&#10227; Refresh sign-ins</a>
  </div>
  <div class="ap-card">
    <p class="ap-learned-empty">No autopilot data yet. Run <code>scripts/sync_autopilot.py</code> in the daily-market-brief folder and commit <code>data/autopilot_rules.json</code>.</p>
  </div>
  {% else %}

  <div class="ap-card">
    <h3>Token health &amp; sign-in</h3>
    <p class="ap-sub">Google sign-ins expire roughly weekly. One click below re-opens the sign-in for each Gmail account and updates everything automatically.</p>
    {% set ts = autopilot_rules.token_status %}
    {% if ts %}
    <p style="margin:0 0 6px;">
      {% for label, rec in ts.accounts.items() %}
      <span class="ap-pill {{ rec.status if rec.status in ['ok','failed'] else 'unknown' }}">{{ label }}: {{ rec.status }}</span>
      {% endfor %}
    </p>
    <p class="ap-sub" style="margin-bottom:8px;">Last sweep: {{ ts.finished_at }}
      {%- set failed = ts.accounts.items() | selectattr('1.status', 'equalto', 'failed') | list -%}
      {% if failed %} &middot; <strong style="color:#b02a2a;">{{ failed | map(attribute=0) | join(', ') }} needs re-sign-in — click the button below.</strong>{% endif %}
    </p>
    {% else %}
    <p class="ap-sub" style="margin-bottom:8px;">No sweep data yet — the button below still works.</p>
    {% endif %}
    <a class="ap-refresh-btn" href="outlook-autopilot:refresh-tokens">&#10227; Refresh sign-ins</a>
    <p class="ap-foot">Opens a window on this PC; a browser tab appears for each Google account (2 sign-ins total). Nothing else to do — new tokens are saved and uploaded for you.</p>
  </div>

  <div class="ap-card">
    <h3>Auto-mark as read — exact senders <span class="ap-count">{{ autopilot_rules.auto_read_exact | length }}</span></h3>
    <p class="ap-sub">Emails from these addresses are marked read automatically on arrival.</p>
    <table class="ap-table">
      <thead><tr><th style="width:26%">Sender</th><th style="width:34%">Address</th><th>Notes</th></tr></thead>
      <tbody>
      {% for s in autopilot_rules.auto_read_exact %}
      <tr>
        <td class="ap-name">{{ s.name or "—" }}</td>
        <td class="ap-addr">{{ s.address }}</td>
        <td class="ap-notes">{{ s.notes }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="ap-card">
    <h3>Auto-mark as read — patterns <span class="ap-count">{{ autopilot_rules.auto_read_patterns | length }}</span></h3>
    <p class="ap-sub">Any email whose sender address or subject matches is marked read (covers <code class="ap-pattern">noreply</code>, <code class="ap-pattern">no-reply</code>, <code class="ap-pattern">no_reply</code>…).</p>
    <p>
      {% for p in autopilot_rules.auto_read_patterns %}
      <span class="ap-pattern">{{ p }}</span>{% if not loop.last %} &nbsp; {% endif %}
      {% endfor %}
    </p>
  </div>

  <div class="ap-card">
    <h3>Learned by the AI <span class="ap-count">{{ autopilot_rules.learned | length }}</span></h3>
    <p class="ap-sub">Senders you batch-marked as read without opening (3 silent-marks) — auto-added by the autopilot.</p>
    {% if autopilot_rules.learned %}
    <table class="ap-table">
      <thead><tr><th style="width:40%">Address</th><th>Origin</th></tr></thead>
      <tbody>
      {% for a in autopilot_rules.learned %}
      <tr>
        <td class="ap-addr">{{ a }}</td>
        <td><span class="ap-badge learned">learned automatically</span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="ap-learned-empty">None yet — the AI adds senders here after you batch-mark their emails as read a few times.</p>
    {% endif %}
  </div>

  <div class="ap-card">
    <h3>Whitelist — always keep unread <span class="ap-count">{{ autopilot_rules.whitelist | length }}</span></h3>
    <p class="ap-sub">Never marked, never learned — these always stay unread for manual review.</p>
    <table class="ap-table">
      <thead><tr><th style="width:26%">Sender</th><th style="width:34%">Address</th><th>Notes</th></tr></thead>
      <tbody>
      {% for s in autopilot_rules.whitelist %}
      <tr>
        <td class="ap-name">{{ s.name or "—" }}</td>
        <td class="ap-addr">{{ s.address }}</td>
        <td class="ap-notes">{{ s.notes }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <p class="ap-foot">Reversal: mark an auto-marked email as unread and that sender is instantly un-learned. To refresh this page after rules change: <code>python scripts/sync_autopilot.py</code>, then commit.</p>
  {% endif %}
</div>

{% include "partials/core.js.j2" %}
</body>
</html>
